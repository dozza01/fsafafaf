function requestNvidiaCompletion(model, apiKey, prompt, text, callback) {
GM_xmlhttpRequest({
method: 'POST', url: 'https://integrate.api.nvidia.com/v1/chat/completions',
timeout: 25000,
headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json', 'Accept': 'application/json' },
data: JSON.stringify({ model: model, messages: [{ role: 'system', content: prompt }, { role: 'user', content: text }], temperature: 0.3, max_tokens: 1024 }),
onload: function (response) {
try {
const data = JSON.parse(response.responseText);
if (data.choices && data.choices[0] && data.choices[0].message) { callback({ ok: true, text: data.choices[0].message.content.trim() }); return; }
if (data.error) { callback({ ok: false, error: data.error.message || data.error.detail || 'Ошибка NVIDIA API' }); return; }
if (data.title || data.detail) { callback({ ok: false, error: `${data.title || 'Ошибка NVIDIA'}${data.detail ? ': ' + data.detail : ''}` }); return; }
callback({ ok: false, error: 'Неверный формат ответа NVIDIA' });
} catch (e) { callback({ ok: false, error: 'Ошибка парсинга ответа NVIDIA: ' + e.message }); }
},
onerror: function () { callback({ ok: false, error: 'Ошибка соединения с NVIDIA API' }); },
ontimeout: function () { callback({ ok: false, error: 'Таймаут ответа от NVIDIA API' }); }
});
}

// ===== DeepL — прямой вызов JSON-RPC API (как в официальном расширении) =====
function getDeepLTimestamp(i_count) {
const ts = Date.now();
if (i_count === 0) return ts;
i_count++;
return ts - (ts % i_count) + i_count;
}
function translateWithDeepL(text, targetLang, callback) {
const url = 'https://www2.deepl.com/jsonrpc';
const id = Math.floor(Math.random() * 9000000) + 1000000;
const langMap = {
'en': 'EN-US', 'ru': 'RU', 'de': 'DE', 'fr': 'FR', 'es': 'ES',
'it': 'IT', 'pt': 'PT-BR', 'pt-BR': 'PT-BR', 'nl': 'NL', 'pl': 'PL',
'ja': 'JA', 'zh-CN': 'ZH', 'zh-TW': 'ZH', 'zh': 'ZH', 'ko': 'KO',
'ar': 'AR', 'tr': 'TR', 'uk': 'UK', 'cs': 'CS', 'da': 'DA',
'fi': 'FI', 'el': 'EL', 'hu': 'HU', 'id': 'ID', 'no': 'NB',
'nb': 'NB', 'ro': 'RO', 'sv': 'SV', 'bg': 'BG', 'hr': 'HR',
'sk': 'SK', 'sl': 'SL', 'et': 'ET', 'lt': 'LT', 'lv': 'LV'
};
const dlTarget = langMap[targetLang] || targetLang.toUpperCase();
const i_count = (text.match(/i/g) || []).length;
const timestamp = getDeepLTimestamp(i_count);
const payload = {
jsonrpc: "2.0",
method: "LMT_handle_jobs",
params: {
jobs: [{
kind: "default",
raw_en_sentence: text,
raw_en_context_before: [],
raw_en_context_after: [],
preferred_num_beams: 4
}],
lang: {
target_lang: dlTarget,
source_lang_computed: "auto"
},
priority: 1,
commonJobParams: {
browserVisible: true,
browserType: "Chrome",
version: "20240917"
},
timestamp: timestamp
},
id: id
};
let jsonStr = JSON.stringify(payload);
if (id % 3 === 0) {
jsonStr = jsonStr.replace(/","/g, '", "').replace(/":"/g, '": "').replace(/":/g, '": ');
} else {
jsonStr = jsonStr.replace(/","/g, '", "').replace(/":"/g, '": "');
}
GM_xmlhttpRequest({
method: 'POST',
url: url,
timeout: 15000,
headers: {
'Content-Type': 'application/json; charset=UTF-8',
'Accept': '*/*',
'X-App-Name': 'chrome-extension',
'Origin': 'https://www.deepl.com',
'Referer': 'https://www.deepl.com/'
},
data: jsonStr,
onload: function (response) {
try {
const data = JSON.parse(response.responseText);
if (data.result && data.result.translations && data.result.translations[0]) {
const beams = data.result.translations[0].beams;
if (beams && beams.length > 0) {
callback(beams[0].postprocessed_sentence, data.result.lang || null);
} else {
callback('Ошибка: DeepL вернул пустой результат', null);
}
} else if (data.error) {
const msg = data.error.message || 'неизвестная ошибка';
if (response.status === 429 || msg.indexOf('quota') !== -1) {
callback('DeepL: превышен лимит запросов. Подождите минуту.', null);
} else {
callback('Ошибка DeepL: ' + msg, null);
}
} else {
callback('Ошибка: неверный формат ответа DeepL', null);
}
} catch (e) {
callback('Ошибка разбора ответа DeepL: ' + e.message, null);
}
},
onerror: function () { callback('Ошибка соединения с DeepL', null); },
ontimeout: function () { callback('Таймаут при обращении к DeepL', null); }
});
}

